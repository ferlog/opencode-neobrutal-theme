{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "primary": "#1a73e8",
    "primaryDark": "#185abc",
    "secondary": "#00897b",
    "accent": "#ff6d00",
    "success": "#2e7d32",
    "warning": "#f9a825",
    "danger": "#d32f2f",
    "info": "#039be5",
    "bgDark": "#121212",
    "bgLight": "#eceff1",
    "surfaceDark": "#1e1e1e",
    "surfaceLight": "#f5f5f5",
    "surfaceLightLight": "#fafafa",
    "textDark": "#e8eaed",
    "textLight": "#1c1c1e",
    "textMutedDark": "#9aa0a6",
    "textMutedLight": "#5f6368",
    "borderDark": "#3d3d5c",
    "borderLight": "#c5c7c9",
    "mdHeading": "#ff7043",
    "mdHeadingStrong": "#ff5722",
    "mdStrong": "#4fc3f7",
    "mdEmph": "#b39ddb",
    "mdLink": "#40c4ff",
    "mdList": "#ffd740",
    "mdCode": "#80deea",
    "mdQuote": "#ffe0b2",
    "mdQuoteBar": "#ff6d00",
    "mdCodeBg": "#1b1b2f"
  },
  "theme": {
    "primary": { "dark": "primary", "light": "primary" },
    "secondary": { "dark": "secondary", "light": "secondary" },
    "accent": { "dark": "accent", "light": "accent" },
    "error": { "dark": "danger", "light": "danger" },
    "warning": { "dark": "warning", "light": "warning" },
    "success": { "dark": "success", "light": "success" },
    "info": { "dark": "info", "light": "info" },
    "text": { "dark": "textDark", "light": "textLight" },
    "textMuted": { "dark": "textMutedDark", "light": "textMutedLight" },
    "background": { "dark": "bgDark", "light": "bgLight" },
    "backgroundPanel": { "dark": "surfaceDark", "light": "surfaceLight" },
    "backgroundElement": { "dark": "surfaceDark", "light": "surfaceLightLight" },
    "border": { "dark": "borderDark", "light": "borderLight" },
    "borderActive": { "dark": "primary", "light": "primary" },
    "borderSubtle": { "dark": "borderDark", "light": "borderLight" },
    "diffAdded": { "dark": "success", "light": "success" },
    "diffRemoved": { "dark": "danger", "light": "danger" },
    "diffContext": { "dark": "textMutedDark", "light": "textMutedLight" },
    "diffHunkHeader": { "dark": "textMutedDark", "light": "textMutedLight" },
    "diffHighlightAdded": { "dark": "success", "light": "success" },
    "diffHighlightRemoved": { "dark": "danger", "light": "danger" },
    "diffAddedBg": { "dark": "#1b5e20", "light": "#e8f5e9" },
    "diffRemovedBg": { "dark": "#b71c1c", "light": "#ffebee" },
    "diffContextBg": { "dark": "surfaceDark", "light": "surfaceLight" },
    "diffLineNumber": { "dark": "textMutedDark", "light": "textMutedLight" },
    "diffAddedLineNumberBg": { "dark": "#1b5e20", "light": "#e8f5e9" },
    "diffRemovedLineNumberBg": { "dark": "#b71c1c", "light": "#ffebee" },
    "markdownText": { "dark": "textDark", "light": "textLight" },
    "markdownHeading": { "dark": "mdHeading", "light": "mdHeadingStrong" },
    "markdownLink": { "dark": "mdLink", "light": "mdLink" },
    "markdownLinkText": { "dark": "mdLink", "light": "mdLink" },
    "markdownCode": { "dark": "mdCode", "light": "mdCode" },
    "markdownBlockQuote": { "dark": "mdQuote", "light": "mdQuote" },
    "markdownEmph": { "dark": "mdEmph", "light": "mdEmph" },
    "markdownStrong": { "dark": "mdStrong", "light": "mdStrong" },
    "markdownHorizontalRule": { "dark": "borderDark", "light": "borderLight" },
    "markdownListItem": { "dark": "mdList", "light": "mdList" },
    "markdownListEnumeration": { "dark": "accent", "light": "accent" },
    "markdownImage": { "dark": "mdLink", "light": "mdLink" },
    "markdownImageText": { "dark": "mdLink", "light": "mdLink" },
    "markdownCodeBlock": { "dark": "mdCodeBg", "light": "#263238" },
    "syntaxComment": { "dark": "textMutedDark", "light": "textMutedLight" },
    "syntaxKeyword": { "dark": "primary", "light": "primary" },
    "syntaxFunction": { "dark": "mdStrong", "light": "primary" },
    "syntaxVariable": { "dark": "accent", "light": "accent" },
    "syntaxString": { "dark": "success", "light": "success" },
    "syntaxNumber": { "dark": "mdEmph", "light": "mdEmph" },
    "syntaxType": { "dark": "accent", "light": "accent" },
    "syntaxOperator": { "dark": "primary", "light": "primary" },
    "syntaxPunctuation": { "dark": "textDark", "light": "textLight" }
  }
}
